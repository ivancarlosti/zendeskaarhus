/**
 * Sample customisation: expand long code blocks.
 *
 * The copy button, the language badge, the capped height and the keyboard
 * scrolling are built into the theme (`src/code-blocks.js` — see
 * docs/customization.md#code-blocks). The theme wraps every block in
 * `.code-block` and keeps the button next to the `<pre>`, so it stays pinned
 * while the code scrolls; do not add a second copy button here.
 *
 * This sample only extends what the theme builds: it appends a "Show all"
 * button below every block the height cap is hiding and lifts
 * `--code-block-max-height` while the block is expanded. Pair it with the
 * `.code-block-toggle` rules in sample/style.css.example.
 */
document.addEventListener("DOMContentLoaded", function () {
  // Translate these two labels, or read them from your own translations.
  const LABELS = {
    expand: "Show all",
    collapse: "Show less",
  };

  let nextId = 1;

  function addToggle(wrapper) {
    if (wrapper.dataset.toggleReady === "true") return;

    const pre = wrapper.querySelector(":scope > pre");
    if (!pre) return;

    // Nothing to reveal when the whole snippet already fits inside the cap.
    if (pre.scrollHeight <= pre.clientHeight) return;

    if (!pre.id) pre.id = "code-block-" + nextId++;

    const button = document.createElement("button");
    button.className = "code-block-toggle";
    button.type = "button";
    button.textContent = LABELS.expand;
    button.setAttribute("aria-controls", pre.id);
    button.setAttribute("aria-expanded", "false");

    button.addEventListener("click", function () {
      const expanded = wrapper.dataset.expanded !== "true";

      if (expanded) {
        wrapper.dataset.expanded = "true";
        // `--code-block-max-height` is the theme's public knob; `none` removes
        // the cap. The theme's ResizeObserver re-measures the block, so the
        // `tabindex` it added for keyboard scrolling goes away on its own.
        pre.style.setProperty("--code-block-max-height", "none");
      } else {
        wrapper.removeAttribute("data-expanded");
        pre.style.removeProperty("--code-block-max-height");
      }

      button.setAttribute("aria-expanded", String(expanded));
      button.textContent = expanded ? LABELS.collapse : LABELS.expand;
    });

    wrapper.appendChild(button);
    wrapper.dataset.toggleReady = "true";
  }

  // The theme enhances the blocks on DOMContentLoaded, so `load` runs after
  // every `.code-block` wrapper exists. Content injected later (AJAX, modals)
  // is not covered — call this again if you need it.
  window.addEventListener("load", function () {
    document.querySelectorAll(".code-block").forEach(addToggle);
  });
});
