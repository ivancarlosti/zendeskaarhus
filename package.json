{
  "name": "aarhus-theme",
  "version": "1.5.2",
  "description": "Aarhus — a modern, accessible Zendesk Help Center theme",
  "license": "Apache-2.0",
  "author": "Ivan Carlos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivancarlosti/zendeskaarhus.git"
  },
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production rollup -c",
    "prebuild": "rm -f assets/*-bundle.js",
    "watch": "rollup -c -w",
    "preview": "zcli themes:preview",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC jest",
    "test:watch": "TZ=UTC jest --watch",
    "validate": "python3 build/validate.py",
    "version:check": "node build/version.mjs check",
    "version:bump": "node build/version.mjs bump",
    "version:set": "node build/version.mjs set",
    "artwork": "python3 build/artwork.py",
    "zcli": "zcli"
  },
  "dependencies": {
    "@zendesk/help-center-wysiwyg": "2.0.0",
    "@zendeskgarden/container-grid": "^3.0.21",
    "@zendeskgarden/container-utilities": "^2.0.5",
    "@zendeskgarden/react-accordions": "9.16.1",
    "@zendeskgarden/react-avatars": "9.16.1",
    "@zendeskgarden/react-breadcrumbs": "9.16.1",
    "@zendeskgarden/react-buttons": "9.16.1",
    "@zendeskgarden/react-datepickers": "9.16.1",
    "@zendeskgarden/react-dropdowns": "9.16.1",
    "@zendeskgarden/react-forms": "9.16.1",
    "@zendeskgarden/react-grid": "9.16.1",
    "@zendeskgarden/react-loaders": "9.16.1",
    "@zendeskgarden/react-modals": "9.16.1",
    "@zendeskgarden/react-notifications": "9.16.1",
    "@zendeskgarden/react-pagination": "9.16.1",
    "@zendeskgarden/react-tables": "9.16.1",
    "@zendeskgarden/react-tabs": "9.16.1",
    "@zendeskgarden/react-tags": "9.16.1",
    "@zendeskgarden/react-theming": "9.16.1",
    "@zendeskgarden/react-tooltips": "9.16.1",
    "@zendeskgarden/react-typography": "9.16.1",
    "@zendeskgarden/svg-icons": "8.4.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.18",
    "i18next": "^27.1.3",
    "linkify-string": "^4.4.0",
    "linkifyjs": "^4.4.0",
    "lodash": "^4.18.1",
    "lodash.debounce": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^20.2.0",
    "react-i18next": "^18.0.2",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-dynamic-import-vars": "^2.1.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@svgr/rollup": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@zendesk/zcli": "^2.5.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-styled-components": "^7.4.1",
    "rollup": "^4.68.4",
    "rollup-plugin-sass": "^1.15.3",
    "sass": "^1.108.2",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
